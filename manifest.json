{
  "manifest_version": 3,
  "name": "Cybergirl — Trợ lý ảo tiếng Việt",
  "short_name": "Cybergirl",
  "version": "2.0.0",
  "description": "Trợ lý ảo có khuôn mặt, giọng Việt và hội thoại AI chạy trong Microsoft Edge trên Windows.",
  "author": "Long Ngo",
  "minimum_chrome_version": "110",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Mở Cybergirl"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
