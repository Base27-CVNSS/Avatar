{
  "manifest_version": 3,
  "name": "Cybergirl — Trợ lý ảo tiếng Việt",
  "short_name": "Cybergirl",
  "version": "3.3.0",
  "description": "Avatar AI tiếng Việt thời gian thực với Chat live, ghi âm cục bộ, Face Mesh và companion VAD–Whisper–LLM–TTS.",
  "author": "Long Ngo",
  "key": "",
  "minimum_chrome_version": "110",
  "permissions": [
    "storage",
    "nativeMessaging"
  ],
  "action": {
    "default_title": "Mở Cybergirl"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
