{
  "manifest_version": 3,
  "name": "Avatar VN — Edge Talking Photo",
  "short_name": "Avatar VN",
  "version": "1.0.0",
  "description": "Tạo ảnh biết nói bằng giọng Việt, nhận giọng nói và nhép môi ngay trong Microsoft Edge, không cần máy chủ.",
  "author": "Long Ngo",
  "minimum_chrome_version": "110",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Mở Avatar VN"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
